<span class=\"font-label-sm text-label-sm text-primary font-medium\">96.4% uptime</span>\n</div>\n</div>\n<!-- Metric 2: Critical Blockers -->\n<div class=\"bg-surface-container-lowest p-space-md rounded shadow-sm flex flex-col justify-between relative overflow-hidden group\">\n<div class=\"absolute right-0 top-0 bottom-0 w-1 bg-error\"></div>\n<div class=\"flex items-center justify-between text-error\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider font-semibold\">Critical Blockers</span>\n<span class=\"material-symbols-outlined text-lg animate-bounce\" style=\"font-variation-settings: 'FILL' 1;\">fmd_bad</span>\n</div>\n<div class=\"flex items-baseline justify-between mt-space-sm\">\n<div class=\"flex items-center gap-space-xs\">\n<span class=\"font-headline-xl text-headline-xl text-error font-semibold tracking-normal\">03</span>\n<span class=\"font-label-sm text-label-sm text-error/80 uppercase tracking-normaler\">P1 Priority</span>\n</div>\n<span class=\"font-label-sm text-label-sm px-1.5 py-0.5 rounded bg-error-container text-on-error-container font-semibold\">Action Required</span>\n</div>\n<div class=\"mt-space-xs flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm\">\n<span class=\"text-error font-medium\">Lines Stalled: Austin &amp; Stuttgart</span>\n<span class=\"font-label-sm text-label-sm font-code-data text-outline\">Immediate SLA risk</span>\n</div>\n</div>\n<!-- Metric 3: Avg Resolution Time -->\n<div class=\"bg-surface-container-lowest p-space-md rounded shadow-sm flex flex-col justify-between relative overflow-hidden group\">\n<div class=\"absolute right-0 top-0 bottom-0 w-1 bg-primary\"></div>\n<div class=\"flex items-center justify-between text-outline\">\n<span class=\"font-label-sm text-label-sm uppercase tracking-wider\">Avg Resolution Time</span>\n<span class=\"material-symbols-outlined text-lg text-primary\">timer</span>\n</div>\n<div class=\"flex items-baseline justify-between mt-space-sm